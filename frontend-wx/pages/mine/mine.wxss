/**
 * 个人中心 - 简约清新设计
 */

/* 个人信息卡片 */
.profile-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 34rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
  border: 1rpx solid rgba(226, 232, 240, 0.7);
}

.profile-main {
  display: flex;
  align-items: center;
}

.avatar-ring {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  padding: 4rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  margin-right: 22rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.25);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #ffffff;
}

.avatar-text-box {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 46rpx;
  font-weight: 700;
  color: #10b981;
}

.user-info-box {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.user-nickname {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.user-badge {
  background: #ecfdf5;
  color: #059669;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.user-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: #64748b;
}

.sub-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10b981;
}

.login-prompt-box {
  flex: 1;
  min-width: 0;
}

.prompt-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.prompt-desc {
  font-size: 23rpx;
  color: #94a3b8;
}

.login-btn-row {
  margin-top: 24rpx;
}

.login-btn {
  width: 100%;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 订单宫格卡片 */
.order-grid-card {
  padding: 26rpx;
}

.grid-header {
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.grid-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #0f172a;
}

.grid-more {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.grid-more .arrow {
  font-size: 22rpx;
}

.grid-items {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-top: 24rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.grid-item:active {
  opacity: 0.75;
}

.item-icon-box {
  width: 82rpx;
  height: 82rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-icon-box.yellow { background: #fffbeb; }
.item-icon-box.blue { background: #f0f9ff; }
.item-icon-box.green { background: #ecfdf5; }
.item-icon-box.gray { background: #f8fafc; border: 1rpx solid #e2e8f0; }

.grid-icon {
  font-size: 38rpx;
}

.grid-label {
  font-size: 24rpx;
  color: #334155;
  font-weight: 500;
}

/* 功能列表卡片 */
.menu-card {
  padding: 8rpx 26rpx;
}

.menu-item {
  padding: 26rpx 0;
}

.menu-item:active {
  opacity: 0.8;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.menu-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  background: #f1f5f9;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.merchant-icon-wrap {
  background: #ecfdf5;
}

.menu-emoji {
  font-size: 34rpx;
}

.menu-text-group {
  display: flex;
  flex-direction: column;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.menu-sub {
  font-size: 21rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.manage-tag {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.menu-item .arrow {
  font-size: 24rpx;
  color: #cbd5e1;
}

.menu-divider {
  height: 1rpx;
  background: #f1f5f9;
}

/* 退出登录 */
.logout-wrapper {
  margin: 40rpx 0 20rpx;
}

.logout-btn {
  background: #ffffff;
  color: #f43f5e;
  border: 1rpx solid rgba(244, 63, 94, 0.2);
  border-radius: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 27rpx;
  font-weight: 500;
  text-align: center;
}

.logout-btn:active {
  background: #fff1f2;
}
