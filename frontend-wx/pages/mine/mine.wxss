.profile { display: flex; align-items: center; min-height: 170rpx; }.avatar { width: 100rpx; height: 100rpx; line-height: 100rpx; border-radius: 50%; background: #e8f1ff; color: #1677ff; text-align: center; font-size: 40rpx; margin-right: 24rpx; }.nickname { font-weight: bold; font-size: 34rpx; }.menu { padding: 0 24rpx; }.menu > view { padding: 28rpx 0; }.logout { border-top: 1rpx solid #edf0f4; color: #e5484d; }
