<view class="page"><view class="profile panel"><view class="avatar">{{avatarText}}</view><view wx:if="{{user}}"><view class="nickname">{{user.nickName || user.nick_name || user.nickname || '微信用户'}}</view><view class="muted">顾客端已登录</view></view><button wx:else class="primary" bindtap="login">顾客登录</button></view><view class="panel menu"><view class="between" bindtap="orders"><text>我的订单</text><text class="muted">查看全部 ></text></view><view class="between merchant-entry" bindtap="merchant"><text>商家配送端</text><text class="muted">管理员登录 ></text></view><view wx:if="{{user}}" class="logout" bindtap="clear">退出顾客登录</view></view></view>
