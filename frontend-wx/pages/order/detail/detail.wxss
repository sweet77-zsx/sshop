/**
 * 订单详情 - 简约清新设计
 */

/* 头部状态彩卡 Hero */
.hero-card {
  border-radius: 24rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.hero-pending {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.hero-delivering {
  background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
}

.hero-completed {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.hero-rejected {
  background: linear-gradient(135deg, #64748b 0%, #475569 100%);
}

.hero-left {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-desc {
  font-size: 23rpx;
  opacity: 0.92;
  margin-top: 10rpx;
  line-height: 1.45;
}

.hero-icon-bubble {
  width: 90rpx;
  height: 90rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
  flex-shrink: 0;
}

.hero-icon {
  font-size: 46rpx;
}

/* 标题行通用 */
.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.card-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.card-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #0f172a;
}

/* 核心扫码付款卡片 */
.qr-card {
  border: 1.5rpx solid rgba(16, 185, 129, 0.25);
  background: #ffffff;
}

.qr-header {
  margin-bottom: 20rpx;
}

.qr-click-tip {
  font-size: 22rpx;
  color: #10b981;
  background: #ecfdf5;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.qr-box {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #cbd5e1;
}

.qr-image {
  width: 420rpx;
  height: 420rpx;
  max-width: 100%;
  border-radius: 12rpx;
  background: #ffffff;
}

.qr-zoom-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 14rpx;
}

.zoom-icon {
  font-size: 24rpx;
}

.qr-tip-box {
  background: #fffbeb;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
}

.qr-tip-icon {
  font-size: 24rpx;
}

.qr-tip-text {
  font-size: 22rpx;
  color: #b45309;
  flex: 1;
}

.qr-bottom-note {
  font-size: 21rpx;
  color: #94a3b8;
  text-align: center;
  margin-top: 16rpx;
}

/* 配送信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 26rpx;
}

.info-label {
  color: #64748b;
  flex-shrink: 0;
  width: 140rpx;
}

.info-value {
  color: #1e293b;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.info-value.bold {
  font-weight: 700;
  color: #0f172a;
}

.info-value.code {
  font-family: monospace;
}

.info-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.copy-link {
  font-size: 22rpx;
  color: #0284c7;
  background: #f0f9ff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 商品明细列表 */
.detail-items-list {
  display: flex;
  flex-direction: column;
}

.detail-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.detail-item-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.detail-item-name {
  font-size: 27rpx;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-item-count {
  font-size: 23rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.detail-item-subtotal {
  font-size: 27rpx;
  font-weight: 600;
  color: #1e293b;
  margin-left: 20rpx;
}

.detail-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 16rpx 0;
}

/* 费用小计 */
.cost-summary {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cost-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cost-label {
  font-size: 25rpx;
  color: #64748b;
}

.cost-val {
  font-size: 26rpx;
  color: #1e293b;
}

.cost-val.green {
  color: #10b981;
}

.total-row {
  padding-top: 10rpx;
}

.total-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.total-val {
  font-size: 38rpx;
}

.bottom-actions {
  margin: 36rpx 0 20rpx;
}
