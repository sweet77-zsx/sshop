<view class="page"><view wx:if="{{order}}"><view class="panel hero"><view class="status">{{order.statusText}}</view></view><view class="panel"><view class="section-title">商品</view><view class="line between" wx:for="{{order.itemList}}" wx:key="itemId"><text>{{item.goodsName}} × {{item.goodsNum}}</text><text>¥{{item.goodsPrice}}</text></view><view class="between total"><text>应付金额</text><text class="price">¥{{order.totalAmount}}</text></view></view><view class="panel"><view>收货信息</view><view class="muted info">{{order.addressInfo}}</view><view class="muted info">{{order.remark}}</view><view class="muted info">订单号：{{order.orderNo}}</view><view class="muted">下单时间：{{order.createTime}}</view></view><view class="panel" wx:if="{{order.payQrcode}}"><view class="section-title">送达后扫码付款</view><image class="qrcode" src="{{order.payQrcode}}" mode="aspectFit" /><view class="muted">{{order.deliveryTip}}</view></view></view></view>
