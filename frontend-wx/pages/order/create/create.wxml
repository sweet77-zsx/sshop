<view class="page"><view class="panel"><view class="section-title">商品清单</view><view class="line between" wx:for="{{items}}" wx:key="goodsId"><text>{{item.goodsName}} × {{item.goodsNum}}</text><text>¥{{item.goodsPrice}}</text></view></view><view class="panel"><view class="section-title">收货地址</view><input placeholder="请输入楼栋和房间号" data-field="addressInfo" bindinput="input" value="{{addressInfo}}" /><textarea placeholder="订单备注（选填）" data-field="remark" bindinput="input" /></view><view class="footer between"><text>应付 ¥{{total}}</text><button class="primary" loading="{{submitting}}" bindtap="submit">提交订单</button></view></view>
