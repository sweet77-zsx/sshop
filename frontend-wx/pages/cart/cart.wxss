/**
 * 购物车 - 简约清新设计
 */

.cart-empty {
  padding-top: 200rpx;
}

.empty-btn {
  width: 320rpx;
  margin-top: 10rpx;
}

/* 头部配送横幅卡片 */
.cart-header-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(226, 232, 240, 0.7);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.delivery-icon {
  font-size: 34rpx;
}

.delivery-text-group {
  display: flex;
  flex-direction: column;
}

.delivery-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1e293b;
}

.delivery-sub {
  font-size: 21rpx;
  color: #10b981;
}

.clear-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
}

.clear-btn:active {
  background: #f1f5f9;
}

.trash-icon {
  font-size: 26rpx;
}

/* 购物车列表 */
.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.cart-item-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  border: 1rpx solid rgba(226, 232, 240, 0.7);
}

.item-cover-box {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  overflow: hidden;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.item-cover {
  width: 100%;
  height: 100%;
}

.item-placeholder {
  width: 100%;
  height: 100%;
  background: #f0fdf4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 150rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-stock-tip {
  font-size: 21rpx;
  color: #94a3b8;
}

.item-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

/* 步进器 */
.stepper-box {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border-radius: 36rpx;
  border: 1.5rpx solid #e2e8f0;
  padding: 4rpx;
}

.stepper-btn {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.08);
  transition: all 0.15s ease;
}

.stepper-btn:active {
  transform: scale(0.9);
  background: #f1f5f9;
}

.stepper-btn.disabled {
  opacity: 0.4;
  box-shadow: none;
}

.stepper-icon {
  font-size: 28rpx;
  color: #334155;
  font-weight: 700;
  line-height: 1;
}

.stepper-count {
  width: 60rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 提示卡片 */
.cart-tip-card {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  border: 1rpx solid #e2e8f0;
  margin-bottom: 40rpx;
}

.tip-dot {
  font-size: 26rpx;
  line-height: 1.4;
}

.tip-msg {
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.5;
  flex: 1;
}

/* 吸底结算栏 */
.checkout-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 50rpx;
  padding: 16rpx 20rpx 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 32rpx rgba(15, 23, 42, 0.12);
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  z-index: 99;
}

.checkout-left {
  display: flex;
  flex-direction: column;
}

.checkout-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.total-number {
  font-size: 40rpx;
  color: #f43f5e;
}

.free-shipping-tag {
  font-size: 20rpx;
  color: #10b981;
  font-weight: 500;
}

.checkout-btn {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-weight: 600;
  font-size: 30rpx;
  padding: 0 44rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  box-shadow: 0 6rpx 18rpx rgba(16, 185, 129, 0.35);
}

.checkout-btn:active {
  transform: scale(0.98);
  opacity: 0.95;
}
