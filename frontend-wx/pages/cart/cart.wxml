<view class="page"><view wx:if="{{!items.length}}" class="empty">购物车是空的</view><block wx:else><view class="panel item row" wx:for="{{items}}" wx:key="goodsId"><image src="{{item.goodsCover}}" mode="aspectFill"/><view class="info"><view class="item-name">{{item.goodsName}}</view><text class="price">¥{{item.goodsPrice}}</text></view><view class="stepper"><button data-id="{{item.goodsId}}" bindtap="decrease">−</button><text>{{item.goodsNum}}</text><button data-id="{{item.goodsId}}" bindtap="increase">+</button></view><text class="delete" data-id="{{item.goodsId}}" bindtap="remove">删除</text></view><view class="checkout between"><text>合计 <text class="price">¥{{total}}</text></text><button class="primary" bindtap="checkout">去结算</button></view></block></view>
