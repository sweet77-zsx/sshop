<view class="page">
  <view class="merchant-nav">配送订单</view><view class="merchant-header panel"><view class="between"><text class="shop-state {{config.shopStatus === 0 ? 'closed' : ''}}">{{config.shopStatus === 0 ? '歇业中' : '营业中'}}</text><button class="refresh" bindtap="load">刷新</button></view><view wx:if="{{config.deliveryTip}}" class="muted tip">{{config.deliveryTip}}</view></view>
  <view wx:if="{{loading}}" class="empty">正在加载订单...</view>
  <view wx:elif="{{!orders.length}}" class="empty"><view>暂无订单</view><view class="muted empty-tip">新订单会显示在这里</view></view>
  <block wx:else><view class="panel order" wx:for="{{orders}}" wx:key="orderId" data-id="{{item.orderId}}" bindtap="detail"><view class="between order-head"><text class="order-no">{{item.orderNo}}</text><text class="status status-{{item.orderStatus}}">{{item.statusText}}</text></view><view class="address">{{item.addressInfo}}</view><view wx:if="{{item.remark}}" class="remark">备注：{{item.remark}}</view><view class="between order-foot"><text>{{item.userNickName || '顾客'}}</text><text class="price">¥{{item.totalAmount}}</text></view><view class="order-actions" catchtap="noop"><button wx:if="{{item.orderStatus == 0}}" class="action accept" data-id="{{item.orderId}}" data-type="accept" catchtap="action">接单</button><button wx:if="{{item.orderStatus == 0}}" class="action reject" data-id="{{item.orderId}}" data-type="reject" catchtap="action">拒绝</button><button wx:if="{{item.orderStatus == 1}}" class="action finish" data-id="{{item.orderId}}" data-type="finish" catchtap="action">确认完成</button></view></view></block>
  <button class="logout" bindtap="logout">退出商家端</button>
</view>
