/**
 * 商家配送端登录 - 简约清新设计
 */

.login-container {
  display: flex;
  flex-direction: column;
  padding-top: 40rpx;
}

.top-bar {
  margin-bottom: 50rpx;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #64748b;
  padding: 10rpx 20rpx;
  background: #ffffff;
  border-radius: 30rpx;
  border: 1rpx solid #e2e8f0;
}

.back-arrow {
  font-size: 28rpx;
}

/* 品牌区 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
  text-align: center;
}

.brand-avatar {
  width: 130rpx;
  height: 130rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
  margin-bottom: 24rpx;
}

.brand-icon {
  font-size: 64rpx;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.brand-subtitle {
  font-size: 24rpx;
  color: #64748b;
}

/* 表单卡片 */
.form-card {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 16rpx 22rpx;
}

.input-icon-box {
  width: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.input-icon {
  font-size: 32rpx;
  opacity: 0.7;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.submit-btn {
  margin-top: 14rpx;
  width: 100%;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

/* 底部提示 */
.login-tips {
  margin-top: 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-line {
  font-size: 22rpx;
  color: #94a3b8;
}

.tip-sub {
  font-size: 21rpx;
  color: #cbd5e1;
}
