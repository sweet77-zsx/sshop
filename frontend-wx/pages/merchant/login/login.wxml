<view class="page page-no-bottom login-container">
  <!-- 返回顾客端按钮 -->
  <view class="top-bar">
    <view class="back-link" bindtap="goCustomer">
      <text class="back-arrow">←</text>
      <text>返回顾客端</text>
    </view>
  </view>

  <!-- 品牌 Logo 与标题 -->
  <view class="brand-section">
    <view class="brand-avatar">
      <text class="brand-icon">🛵</text>
    </view>
    <view class="brand-title">食刻商家配送中心</view>
    <view class="brand-subtitle">校园小卖部专人实时接单与送货平台</view>
  </view>

  <!-- 登录表单卡片 -->
  <view class="card form-card">
    <view class="form-item">
      <view class="input-icon-box">
        <text class="input-icon">👤</text>
      </view>
      <input 
        class="form-input" 
        placeholder="请输入管理员账号" 
        data-field="username" 
        bindinput="input" 
        value="{{username}}" 
      />
    </view>

    <view class="form-item">
      <view class="input-icon-box">
        <text class="input-icon">🔒</text>
      </view>
      <input 
        class="form-input" 
        password 
        placeholder="请输入管理员密码" 
        data-field="password" 
        bindinput="input" 
        value="{{password}}" 
      />
    </view>

    <button class="btn-primary submit-btn" loading="{{loading}}" bindtap="submit">
      立即登录配送端
    </button>
  </view>

  <!-- 提示与帮助 -->
  <view class="login-tips">
    <text class="tip-line">管理员 Token 与顾客端微信 Token 相互独立</text>
    <text class="tip-sub">默认账号: admin / 默认密码: secret</text>
  </view>
</view>
