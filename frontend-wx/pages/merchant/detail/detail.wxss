.order-title { font-size: 36rpx; font-weight: 700; }.order-no { margin-top: 14rpx; color: #8b929f; font-size: 24rpx; }.status { margin-top: 24rpx; font-weight: 700; color: #1677ff; }.address, .remark { margin-top: 22rpx; line-height: 1.6; }.line { padding: 18rpx 0; }.total { border-top: 1rpx solid #eee; padding-top: 22rpx; margin-top: 20rpx; }.detail-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }.action { flex: 1; margin: 0; line-height: 70rpx; font-size: 27rpx; }.accept { color: #1677ff; background: #eef5ff; }.reject { color: #e5484d; background: #fff1f1; }.finish { color: #198754; background: #edfaf3; }.open-qr { margin: 0; padding: 0 20rpx; line-height: 58rpx; color: #1677ff; background: #eef5ff; font-size: 24rpx; }.qrcode { display: block; width: 560rpx; height: 560rpx; max-width: 100%; margin: 24rpx auto 0; object-fit: contain; }
.merchant-nav { padding: 22rpx 0 28rpx; font-size: 36rpx; font-weight: 700; }.nav-logout { margin: 0; padding: 0 18rpx; line-height: 54rpx; font-size: 23rpx; color: #e5484d; background: #fff1f1; }
