<view class="page"><view class="merchant-nav between"><text>订单详情</text><button class="nav-logout" bindtap="logout">退出配送端</button></view><view wx:if="{{detail}}"><view class="panel"><view class="order-title">订单详情</view><view class="order-no">{{detail.order.orderNo}}</view><view class="status">{{statusText}}</view><view class="address">{{detail.order.addressInfo}}</view><view class="remark">备注：{{detail.order.remark || '无'}}</view><view class="detail-actions"><button wx:if="{{detail.order.orderStatus == 0}}" class="action accept" data-type="accept" bindtap="action">接单</button><button wx:if="{{detail.order.orderStatus == 0}}" class="action reject" data-type="reject" bindtap="action">拒绝</button><button wx:if="{{detail.order.orderStatus == 1}}" class="action finish" data-type="finish" bindtap="action">确认完成</button></view></view><view class="panel"><view class="section-title">商品明细</view><view class="line between" wx:for="{{detail.itemList}}" wx:key="itemId"><text>{{item.goodsName}} × {{item.goodsNum}}</text><text>¥{{item.goodsPrice}}</text></view><view class="between total"><text>合计</text><text class="price">¥{{detail.order.totalAmount}}</text></view></view><view class="panel qr-panel"><view class="between"><view class="section-title">线下收款码</view><button wx:if="{{detail.payQrcode}}" class="open-qr" bindtap="openQrcode">打开大图</button></view><image wx:if="{{detail.payQrcode}}" class="qrcode" src="{{detail.payQrcode}}" mode="aspectFit" /><view wx:else class="muted">暂无收款码</view><view class="muted">送达后请让顾客扫码付款</view></view></view><view wx:else class="empty">订单加载失败</view></view>
