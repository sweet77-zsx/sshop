.shop-status { padding: 20rpx 24rpx; color: #198754; font-weight: 600; }.shop-status.closed { color: #e5484d; }.delivery-tip { margin: 20rpx 0 26rpx; padding: 20rpx 24rpx; color: #697386; font-size: 25rpx; line-height: 1.6; background: #fff; border-radius: 14rpx; }.search { background: #fff; border-radius: 48rpx; padding: 22rpx 30rpx; margin-bottom: 32rpx; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }.product { padding: 0 0 18rpx; overflow: hidden; }.cover { width: 100%; height: 280rpx; background: #edf0f4; }.name, .product .muted, .product .between { margin: 12rpx 18rpx 0; }.name { font-weight: 600; }.product .muted { height: 36rpx; overflow: hidden; font-size: 23rpx; }.price { color: #e5484d; font-weight: bold; }.add { font-size: 22rpx; line-height: 54rpx; height: 54rpx; background: #eaf2ff; color: #1677ff; }
