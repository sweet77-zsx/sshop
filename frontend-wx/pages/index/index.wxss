/**
 * 首页 - 简约清新校园零食小铺样式
 */

/* 店铺头部卡片 */
.store-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.06);
  border: 1rpx solid rgba(16, 185, 129, 0.12);
}

.store-info-row {
  display: flex;
  align-items: center;
}

.store-avatar {
  width: 90rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.25);
  flex-shrink: 0;
}

.store-avatar-text {
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
  font-family: "PingFang SC", sans-serif;
}

.store-detail {
  flex: 1;
  min-width: 0;
}

.store-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-pill.open {
  background: #ecfdf5;
  color: #059669;
}

.status-pill.closed {
  background: #fef2f2;
  color: #dc2626;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-pill.open .status-dot {
  background: #10b981;
  box-shadow: 0 0 8rpx #10b981;
}

.status-pill.closed .status-dot {
  background: #dc2626;
}

.store-slogan {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.slogan-badge {
  background: #e0f2fe;
  color: #0284c7;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.slogan-text {
  font-size: 23rpx;
  color: #64748b;
}

/* 公告提示栏 */
.notice-bar {
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  background: #fffbeb;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.2);
}

.notice-icon {
  font-size: 26rpx;
}

.notice-content {
  font-size: 23rpx;
  color: #b45309;
  line-height: 1.4;
  flex: 1;
}

/* 搜索栏 */
.search-box {
  margin-bottom: 20rpx;
}

.search-inner {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  border: 1.5rpx solid #e2e8f0;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.02);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #1e293b;
}

.search-clear {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  margin-left: 10rpx;
}

/* 分类标签横向滑动 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  color: #64748b;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  transition: all 0.2s ease;
  font-weight: 500;
}

.category-item.active {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  border-color: #10b981;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.22);
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.035);
  border: 1rpx solid rgba(226, 232, 240, 0.7);
  display: flex;
  flex-direction: column;
  transition: transform 0.15s ease;
}

.card-hover {
  transform: translateY(-2rpx);
}

/* 商品封面包装 */
.cover-wrapper {
  position: relative;
  width: 100%;
  height: 290rpx;
  background: #f1f5f9;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
  background: #edf2f7;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

.placeholder-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.placeholder-text {
  font-size: 22rpx;
  color: #059669;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 85%;
}

.sold-out-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(2px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sold-out-badge {
  background: rgba(0, 0, 0, 0.65);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
}

/* 商品文字区 */
.product-content {
  padding: 18rpx 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.product-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.35;
  height: 72rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-remark {
  font-size: 21rpx;
  color: #94a3b8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 6rpx;
  margin-bottom: 10rpx;
}

.stock-status {
  margin-bottom: 12rpx;
}

.stock-pill {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.stock-pill.low {
  background: #fff7ed;
  color: #ea580c;
}

.stock-pill.out {
  background: #fef2f2;
  color: #dc2626;
}

.stock-pill.normal {
  background: #f8fafc;
  color: #64748b;
}

/* 底部价格与加号 */
.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 8rpx;
}

.add-btn-wrap {
  position: relative;
}

.add-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
  transition: transform 0.15s ease;
}

.add-btn:active {
  transform: scale(0.9);
}

.add-btn.disabled {
  background: #cbd5e1;
  box-shadow: none;
}

.plus-icon {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  margin-top: -2rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #f43f5e;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 700;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  border-radius: 15rpx;
  text-align: center;
  padding: 0 6rpx;
  border: 2rpx solid #ffffff;
}

/* 悬浮购物车栏 */
.float-cart-bar {
  position: fixed;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  right: 28rpx;
  background: #1e293b;
  color: #ffffff;
  border-radius: 54rpx;
  height: 98rpx;
  padding: 0 16rpx 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.25);
  z-index: 99;
}

.float-cart-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cart-icon-bubble {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  background: #10b981;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.4);
}

.bubble-icon {
  font-size: 34rpx;
}

.bubble-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #f43f5e;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 6rpx;
  border: 2rpx solid #1e293b;
}

.float-cart-info {
  display: flex;
  flex-direction: column;
}

.float-total-price {
  display: flex;
  align-items: baseline;
  color: #ffffff;
  font-weight: 700;
}

.float-symbol {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.float-amount {
  font-size: 36rpx;
  font-family: DINAlternate-Bold, -apple-system, sans-serif;
}

.float-sub {
  font-size: 20rpx;
  color: #94a3b8;
}

.float-cart-btn {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-weight: 600;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.float-cart-btn .arrow {
  font-size: 26rpx;
}

/* 简单的加载动效 */
.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #ecfdf5;
  border-top-color: #10b981;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
