/**
 * 食刻零食配送 - 全局简约清新设计系统
 */

/* 页面与全局基调 */
page {
  background-color: #f8fafc;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

view, text, button, input, textarea, image, scroll-view {
  box-sizing: border-box;
}

/* 按钮通用重置 */
button {
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
  font-size: 28rpx;
  border-radius: 0;
}
button::after {
  border: none;
}

/* 页面通用容器 */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-no-bottom {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 清新卡片 */
.panel, .card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.035);
  border: 1rpx solid rgba(226, 232, 240, 0.6);
  position: relative;
  overflow: hidden;
}

/* 文本色彩层级 */
.text-main { color: #0f172a; font-weight: 600; }
.text-body { color: #334155; }
.text-muted, .muted { color: #94a3b8; font-size: 24rpx; }
.text-desc { color: #64748b; font-size: 26rpx; }
.text-primary { color: #10b981; }
.text-price, .price { color: #f43f5e; font-weight: 700; }

/* 价格排版 */
.price-box {
  display: inline-flex;
  align-items: baseline;
  color: #f43f5e;
  font-weight: 700;
}
.price-symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}
.price-val {
  font-size: 36rpx;
  font-family: DINAlternate-Bold, -apple-system, sans-serif;
}

/* 弹性布局类 */
.row, .flex { display: flex; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.between, .flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-1 { flex: 1; min-width: 0; }
.gap-8 { gap: 16rpx; }
.gap-12 { gap: 24rpx; }

/* 按钮规范 */
.btn-primary, .primary {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-weight: 600;
  border-radius: 44rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.28);
  transition: all 0.2s ease;
}

.btn-secondary {
  background: #ecfdf5;
  color: #059669;
  font-weight: 600;
  border-radius: 44rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
}

.btn-sm {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
  border-radius: 30rpx;
}

.btn-outline {
  background: #ffffff;
  border: 1.5rpx solid #cbd5e1;
  color: #475569;
  border-radius: 30rpx;
}

.btn-hover, .btn-primary:active, .primary:active {
  transform: scale(0.98);
  opacity: 0.92;
}

/* 状态标签徽章 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-open, .tag-success {
  background: #ecfdf5;
  color: #059669;
}
.tag-closed, .tag-danger {
  background: #fef2f2;
  color: #dc2626;
}
.tag-pending, .tag-warning {
  background: #fffbeb;
  color: #d97706;
}
.tag-delivering, .tag-info {
  background: #f0f9ff;
  color: #0284c7;
}

/* 空状态设计 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-icon {
  width: 140rpx;
  height: 140rpx;
  background: #f1f5f9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 36rpx;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
